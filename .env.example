# Copy this file to .env. Never commit real values or local runtime paths.
# Leave optional integrations blank unless you intend to use them.
OPENAI_API_KEY=
# Model used for configured structured extraction and grounded writing.
OPENAI_MODEL=gpt-5-mini
# Local-only runtime state. These paths are ignored by Git.
DATABASE_PATH=data/job_agent.sqlite3
BROWSER_PROFILE_PATH=data/browser_profile
# Candidate-independent canonical CV location. Existing registered local CVs remain usable.
CANONICAL_CV_PATH=candidate_documents/canonical_cv.pdf
# Optional: enables role-first Australian discovery through Adzuna's official API.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: configured public-web search resolution integration.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
